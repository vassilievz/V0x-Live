{
  "name": "v0x-live",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @v0xlive/web --filter @v0xlive/api dev",
    "dev:web": "pnpm --filter @v0xlive/web dev",
    "dev:api": "pnpm --filter @v0xlive/api dev",
    "dev:livekit": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/livekit-dev.ps1",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "tinypool": ">=2.1.2"
    }
  }
}
